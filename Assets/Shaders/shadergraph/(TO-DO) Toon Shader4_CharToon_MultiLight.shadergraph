{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "6b4a36d5e6c7446dab018e086ed5550c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ToonILMRamp (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1637.0,
            "y": -115.99999237060547,
            "width": 239.5,
            "height": 374.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "08bad6c950eb47249350cd491b844f17"
        },
        {
            "m_Id": "6aa9b97691e54a51a1d16538903c6b15"
        },
        {
            "m_Id": "a59ab10f0f334b30b85cbf7836c8536b"
        },
        {
            "m_Id": "841afb53827b43f5abc8de8a5f7c00bc"
        },
        {
            "m_Id": "33158f7d8c6742958513505081a27c20"
        },
        {
            "m_Id": "c1153925a63749559e32b16afbb53b19"
        },
        {
            "m_Id": "a878a7da02ce492fa6672931585026f2"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "ToonILMRamp",
    "m_FunctionSource": "a61dea91b769f41d5a5b885953b0a6e9",
    "m_FunctionBody": "// ILM.A selects a material region.\n// Row mapping from the reference material: 3, 4, 1, 5, 2.\nfloat row = 2.0;\nif (ILM.a <= 0.85) row = 5.0;\nif (ILM.a <= 0.60) row = 1.0;\nif (ILM.a <= 0.40) row = 4.0;\nif (ILM.a <= 0.15) row = 3.0;\n\n// Daytime row center in the reference ramp layout.\nfloat rampV = 1.0 - (row * 0.1 - 0.05);\n\n// Reference diffuse response and transition thresholds.\nfloat halfLambert = saturate(NdotL) * 0.5 + 0.5;\nhalfLambert *= halfLambert;\n\nfloat lit = smoothstep(0.42, 0.46, halfLambert);\nfloat rampU = clamp(\n    smoothstep(0.0, 0.35, halfLambert),\n    0.003, 0.997\n);\n\n// Sample mip 0 to avoid mixing different ramp rows.\nfloat3 midRamp = SAMPLE_TEXTURE2D_LOD(\n    Ramp.tex, Ramp.samplerstate,\n    float2(rampU, rampV), 0\n).rgb;\n\nfloat3 darkRamp = SAMPLE_TEXTURE2D_LOD(\n    Ramp.tex, Ramp.samplerstate,\n    float2(0.003, rampV), 0\n).rgb;\n\nfloat3 midColor = BaseColor * midRamp;\nfloat3 darkColor = BaseColor * darkRamp;\n\n// ILM.G: 0 = dark, 0.5 = normal lighting, 1 = bright.\nfloat keepLighting = saturate(ILM.g * 2.0);\nfloat forceBright = saturate((ILM.g - 0.5) * 2.0);\n\nfloat3 diffuse = lerp(midColor, BaseColor, lit);\ndiffuse = lerp(darkColor, diffuse, keepLighting);\ndiffuse = lerp(diffuse, BaseColor, forceBright);\n\n// Keep real main-light shadows.\nfloat visibility = saturate(ShadowAtten);\nToonColor = lerp(darkColor, diffuse, visibility);\n\n// A shading mask for later stylized shadow effects.\nfloat effectiveLit = lerp(lit * keepLighting, 1.0, forceBright);\nShadowMask = 1.0 - effectiveLit * visibility;\n\n"
}

